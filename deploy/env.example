# Copiar a agente/deploy/.env y completar. NUNCA commitear el .env real (está en .gitignore).

# OpenRouter (provider del agente). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Token del bot de GÜIDO (@BotFather). Es el MISMO que va en Vercel como TELEGRAM_BOT_TOKEN:
# Hermes escucha los mensajes; la web sólo manda los avisos de compra con sendMessage.
TELEGRAM_BOT_TOKEN=

# Ids de Telegram habilitados a hablarle al bot (los mismos chat_id de Vercel, separados por coma).
# ⚠️ Vacío = cualquiera que encuentre el bot puede mover stock.
TELEGRAM_ALLOWED_USERS=

# Recursos del contenedor. cpus NO puede superar los vCPU reales del host.
DOCKER_CPUS=0.5
DOCKER_MEMORY=768M

# ⚠️ Las credenciales de Supabase NO van acá: van en agente/deploy/supabase.env
# (ver supabase.env.example). Ese archivo lo lee sólo el server MCP.
